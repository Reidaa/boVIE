{
  "name": "bovie-railway",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "format": "oxfmt \"*.ts\"",
    "format:check": "oxfmt --check \"*.ts\"",
    "lint": "oxlint --deny-warnings .",
    "check": "tsc --noEmit",
    "test": "tsx --test *.test.ts",
    "plan": "tsx deploy.ts plan",
    "apply": "tsx deploy.ts apply"
  },
  "dependencies": {
    "railway": "3.16.0"
  },
  "devDependencies": {
    "@railway/cli": "5.71.0",
    "@types/node": "^24.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0"
  }
}
