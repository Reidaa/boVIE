{
  "name": "bovie-railway",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "format": "oxfmt \"*.ts\"",
    "format:check": "oxfmt --check \"*.ts\"",
    "lint": "oxlint --deny-warnings .",
    "check": "npm run format:check && npm run lint && tsc --noEmit && tsx --test *.test.ts",
    "plan": "tsx deploy.ts plan",
    "apply": "tsx deploy.ts apply"
  },
  "dependencies": {
    "railway": "3.11.0"
  },
  "devDependencies": {
    "@railway/cli": "5.59.0",
    "@types/node": "^22.0.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
