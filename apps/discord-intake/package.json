{
  "name": "@bovie/discord-intake",
  "version": "0.4.0",
  "description": "BoVIE discord-intake",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "discord-intake": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bovie/cli-common": "workspace:*",
    "@bovie/discord-store": "workspace:*",
    "@bovie/mysql-common": "workspace:*",
    "@bovie/nats-client": "workspace:*",
    "@bovie/offer-events": "workspace:*",
    "@nats-io/jetstream": "3.5.0",
    "@nats-io/nats-core": "3.5.0",
    "commander": "15.1.0"
  }
}
