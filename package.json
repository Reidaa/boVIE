{
  "name": "bovie",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "turbo run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "turbo run test",
    "verify": "turbo run lint format:check check test verify:packages",
    "verify:packages": "bun run scripts/check-packages.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "railway": "3.16.0",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  }
}
