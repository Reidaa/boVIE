{
  "name": "bovie",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify": "turbo run lint format:check check test verify:packages",
    "railway:plan": "pnpm --filter bovie-railway run plan",
    "railway:apply": "pnpm --filter bovie-railway run apply",
    "railway": ".railway/node_modules/.bin/railway"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
