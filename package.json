{
  "name": "bovie",
  "private": true,
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "infra/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify": "turbo run lint format:check check test verify:packages",
    "railway:plan": "npm --workspace bovie-railway run plan",
    "railway:apply": "npm --workspace bovie-railway run apply"
  },
  "devDependencies": {
    "turbo": "2.11.3"
  },
  "allowScripts": {
    "@railway/cli@5.59.0": true,
    "esbuild@0.28.2": true
  }
}
