{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "//#lint": {},
    "format": {
      "cache": false
    },
    "//#format": {
      "cache": false
    },
    "format:check": {},
    "//#format:check": {},
    "check": {
      "dependsOn": ["^build"]
    },
    "//#check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["MYSQL_TEST_ADMIN_URL", "NATS_TEST_URL", "NATS_AUTH_TEST_URL"]
    },
    "verify:packages": {},
    "//#verify:packages": {
      "dependsOn": ["^build"]
    }
  }
}
