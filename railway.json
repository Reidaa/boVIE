{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "RAILPACK",
        "watchPatterns": [
            "services/business-france/**",
            "packages/contracts/**",
            "packages/database/**",
            "packages/source-store/**",
            "packages/runtime/**",
            "uv.lock",
            "pyproject.toml"
        ],
        "buildCommand": "uv sync --frozen --no-dev --package bovie-business-france"
    },
    "deploy": {
        "startCommand": "uv run --no-sync bovie",
        "preDeployCommand": "uv run --no-sync source-migrate",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5,
        "cronSchedule": "12 */2 * * *",
        "region": "Europe-west4-drams3a"
    }
}
