# Development only. Each process receives its own DATABASE_URL.
DATABASE_URL=mysql+pymysql://business_france:local-bf-only@127.0.0.1:3306/business_france
# WTTJ: mysql+pymysql://wttj:local-wttj-only@127.0.0.1:3306/wttj
# Notifications: mysql+pymysql://notifications:local-notifications-only@127.0.0.1:3306/notifications
MYSQL_ROOT_PASSWORD=local-root-only
NATS_URL=nats://127.0.0.1:4222
NATS_USER=business_france
NATS_PASSWORD=local-nats-bf
# Compose broker credentials; production must use independent secrets and TLS.
NATS_ADMIN_PASSWORD=local-nats-admin
NATS_BF_PASSWORD=local-nats-bf
NATS_WTTJ_PASSWORD=local-nats-wttj
NATS_NOTIFICATIONS_PASSWORD=local-nats-notifications
DISCORD_WEBHOOK_URL=

BOVIE_REGION="amerique du nord,asie et pacifique,amerique latine"
BOVIE_SPECIALIZATION="information systems,scientific and industrial computing"
BOVIE_LIMIT=25
BOVIE_DEBUG=false
WTTJ_QUERY=
# Optional space-separated contract types; empty accepts all types.
WTTJ_CONTRACTS=
WTTJ_LIMIT=50
WTTJ_MAX_PAGES=5
