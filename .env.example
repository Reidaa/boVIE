# Development only. Each process receives its own DATABASE_URL.
DATABASE_URL=mysql+pymysql://collector_business_france:local-collector-business-france-only@127.0.0.1:3306/collector_business_france
# WTTJ: mysql+pymysql://collector_wttj:local-collector-wttj-only@127.0.0.1:3306/collector_wttj
# Notifications: mysql+pymysql://discord:local-discord-only@127.0.0.1:3306/discord
MYSQL_ROOT_PASSWORD=local-root-only
NATS_URL=nats://127.0.0.1:4222
# Collectors publish with their source's account. WTTJ: collector-wttj / local-nats-collector-wttj
NATS_USER=collector-business-france
NATS_PASSWORD=local-nats-collector-business-france
# Compose broker credentials; production must use independent secrets and TLS.
NATS_SETUP_PASSWORD=local-nats-setup
NATS_COLLECTOR_BUSINESS_FRANCE_PASSWORD=local-nats-collector-business-france
NATS_COLLECTOR_WTTJ_PASSWORD=local-nats-collector-wttj
NATS_DISCORD_INTAKE_PASSWORD=local-nats-discord-intake
DISCORD_WEBHOOK_URL=

BUSINESS_FRANCE_REGION="amerique du nord,asie et pacifique,amerique latine"
BUSINESS_FRANCE_SPECIALIZATION="information systems,scientific and industrial computing"
BUSINESS_FRANCE_LIMIT=25
BUSINESS_FRANCE_DEBUG=false
WTTJ_QUERY=
# Optional space-separated contract types; empty accepts all types.
WTTJ_CONTRACTS=
WTTJ_LIMIT=50
WTTJ_MAX_PAGES=5
